{
  "name": "mv-director-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node test.mjs && node test-graph.mjs && node test-runner.mjs && node test-output.mjs && node test-canvas.mjs && node test-seedvis.mjs",
    "format": "npx --yes prettier@3 --write \"**/*.{mjs,js,css,html,json}\"",
    "format:check": "npx --yes prettier@3 --check \"**/*.{mjs,js,css,html,json}\""
  },
  "engines": {
    "node": ">=22"
  }
}
