# Runtime data: project state, uploaded media and the worker secret.
# Note: files already tracked in data/ stay tracked until removed with `git rm --cached`.
data/
node_modules/
# Local Claude Code tooling and archives (not part of the app).
.claude/
*.rar
# Python bytecode cache (from the drama-veo-blueprint skill scripts).
__pycache__/
*.pyc
obrion/.venv/
*.sqlite3
mv_shotlist_tools.zip

# Vendored external tool (topview 3D layout backend) — large, installed via uv/pnpm
tools/topview-3d-builder/

# Extension build archives and rendered media: kept on disk, out of git. They are
# regenerated by a build or a render, and 16 MB of them bloated one commit.
*.zip
output/**/*.wav
output/**/*.mp4
output/**/*.png
output/**/*.jpg
